# Handwriting Recognition API Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# API Configuration
# =============================================================================

# Application name and version
HANDWRITING_APP_NAME=Handwriting Recognition API
HANDWRITING_APP_VERSION=1.0.0

# Debug mode (true/false)
HANDWRITING_DEBUG=false

# Server configuration
HANDWRITING_HOST=0.0.0.0
HANDWRITING_PORT=8000

# Enable auto-reload (development only)
HANDWRITING_RELOAD=false

# =============================================================================
# OCR Configuration
# =============================================================================

# OCR language code (en, ch, fr, de, es, it, ja, ko, ru, etc.)
HANDWRITING_OCR_LANG=en

# Use angle classification (true/false)
HANDWRITING_OCR_USE_ANGLE_CLS=true

# Use GPU acceleration (true/false)
HANDWRITING_OCR_USE_GPU=false

# Custom model directories (optional)
HANDWRITING_OCR_DET_MODEL_DIR=
HANDWRITING_OCR_REC_MODEL_DIR=
HANDWRITING_OCR_CLS_MODEL_DIR=

# =============================================================================
# Image Processing Configuration
# =============================================================================

# Maximum image size in bytes (10MB default)
HANDWRITING_MAX_IMAGE_SIZE=10485760

# Maximum image dimensions (width, height)
HANDWRITING_MAX_IMAGE_DIMENSIONS=4096,4096

# Allowed image MIME types (comma-separated)
HANDWRITING_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/heic

# =============================================================================
# Processing Configuration
# =============================================================================

# Maximum concurrent OCR requests
HANDWRITING_MAX_CONCURRENT_REQUESTS=10

# Request timeout in seconds
HANDWRITING_REQUEST_TIMEOUT=30

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Enable Prometheus metrics (true/false)
HANDWRITING_ENABLE_METRICS=true

# Metrics server port
HANDWRITING_METRICS_PORT=9090

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
HANDWRITING_LOG_LEVEL=INFO

# Log format (json, text)
HANDWRITING_LOG_FORMAT=json

# =============================================================================
# Security Configuration
# =============================================================================

# API key header name
HANDWRITING_API_KEY_HEADER=X-API-Key

# Maximum request size in bytes (50MB)
HANDWRITING_MAX_REQUEST_SIZE=52428800

# =============================================================================
# Model Configuration
# =============================================================================

# Number of OCR models to cache
HANDWRITING_MODEL_CACHE_SIZE=1

# Preload OCR model on startup (true/false)
HANDWRITING_ENABLE_MODEL_WARMUP=true

# =============================================================================
# Performance Tuning (Advanced)
# =============================================================================

# CPU threads for OCR processing (PaddleOCR)
HANDWRITING_CPU_THREADS=4

# Enable multiprocessing (true/false)
HANDWRITING_USE_MULTIPROCESSING=true

# Enable Intel MKL-DNN optimization (true/false)
HANDWRITING_ENABLE_MKL_DNN=true

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================

# Redis host (for caching and rate limiting)
REDIS_HOST=redis

# Redis port
REDIS_PORT=6379

# Redis database
REDIS_DB=0

# Redis password (optional)
REDIS_PASSWORD=

# =============================================================================
# Database Configuration (Optional)
# =============================================================================

# Database URL (for storing results, optional)
DATABASE_URL=

# =============================================================================
# External Services (Optional)
# =============================================================================

# S3 bucket for model storage (optional)
AWS_S3_BUCKET=
AWS_S3_REGION=us-west-2

# CDN URL for serving results (optional)
CDN_URL=

# =============================================================================
# Development Settings
# =============================================================================

# Enable detailed error messages (development only)
HANDWRITING_ENABLE_DETAILED_ERRORS=false

# Enable request/response logging (development only)
HANDWRITING_ENABLE_REQUEST_LOGGING=false

# Profiling enabled (development only)
HANDWRITING_ENABLE_PROFILING=false